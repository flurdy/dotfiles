#!/usr/bin/env bash
set -euo pipefail
root="${AI_TOOLS_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/ai-tools}"
[ -d "$root" ] || [ ! -d "$HOME/Code/flurdy/ai-tools" ] || root="$HOME/Code/flurdy/ai-tools"
helper="$root/shared/launcher/mkworktree"
if [ ! -x "$helper" ]; then
  echo "cl-mkworktree: canonical ai-tools launcher is unavailable at $helper; set AI_TOOLS_HOME" >&2
  exit 127
fi
exec "$helper" "$@"
