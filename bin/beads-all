#!/usr/bin/env bash
# List open beads with cached Dolt drift, deduping symlinked repos. Never fetches.
#
# usage: beads-all [--ready] [-s STATUSES] [--all] [ROOT]
#   --ready       use `bd ready` instead of `bd list`
#   -s STATUSES   comma-separated statuses for `bd list` (default: open,in_progress,blocked)
#   --all         compatibility alias; all stores are always shown
#   ROOT          defaults to $BEADS_ALL_ROOT, then ~/Code/flurdy
set -euo pipefail

mode=list
statuses=open,in_progress,blocked
script_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
root=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --ready) mode=ready ;;
    -s|--status)
      [[ $# -ge 2 ]] || { echo "missing statuses" >&2; exit 2; }
      statuses=$2; shift ;;
    --all) ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) root=$1 ;;
  esac
  shift
done
if [[ -n ${BEADS_DIR:-} || -n ${BEADS_DB:-} || -n ${BD_DB:-} ]]; then
  echo "beads-all: store overrides are unsupported" >&2
  exit 2
fi
export BEADS_DOLT_AUTO_START=false
root=$(realpath "${root:-${BEADS_ALL_ROOT:-$HOME/Code/flurdy}}")

# Discover stores following symlinks, prefer the shallowest display path, dedupe by real path.
mapfile -t stores < <(
  cd "$root" && find -L . -mindepth 2 -maxdepth 4 -type d -name .beads \
      -not -path '*/tbd/*' -not -path '*/node_modules/*' -not -path '*/.git/*' \
      -not -path '*/.artifacts/*' 2>/dev/null \
    | sed 's|^\./||; s|/\.beads$||' \
    | awk -F/ '{ print NF "\t" $0 }' | sort -n -k1,1 -k2,2 | cut -f2 \
    | while read -r rel; do printf '%s\t%s\n' "$(realpath "$rel")" "$rel"; done \
    | awk -F'\t' '!seen[$1]++ { print $2 }'
)
[[ ${#stores[@]} -gt 0 ]] || { echo "no bead stores under $root" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

run_store() {
  local rel=$1 out=$2
  local -a args=(list -s "$statuses" --no-pager)
  [[ $mode == ready ]] && args=(ready)
  if bd -C "$root/$rel" --readonly --sandbox "${args[@]}" >"$out.raw" 2>/dev/null; then
    grep -vE '^(-{10,}|Total: |Status: |Ready: |No (ready|issues)|$)' "$out.raw" >"$out" || true
  else
    printf 'listing unavailable\n' >"$out"
  fi
  if ! python3 -B "$script_dir/beads-drift.py" "$root/$rel" >"$out.drift" 2>/dev/null; then
    printf 'Dolt: unavailable (reader unavailable)\n' >"$out.drift"
  fi
}
export -f run_store
export root mode statuses script_dir

i=0
for rel in "${stores[@]}"; do
  printf '%s\n' "$rel" >"$tmp/$i.name"
  i=$((i + 1))
done
# Expanded by the child Bash, not this shell.
# shellcheck disable=SC2016
printf '%s\n' "${stores[@]}" | nl -v0 -w1 -s$'\t' \
  | xargs -P8 -n1 -d'\n' bash -c 'IFS="$(printf "\t")" read -r n rel <<<"$2"; run_store "$rel" "$1/$n.out"' _ "$tmp"

for ((n = 0; n < i; n++)); do
  rel=$(<"$tmp/$n.name")
  out="$tmp/$n.out"
  if [[ -s $out ]] && grep -q '[^[:space:]]' "$out"; then
    printf '\n\e[1m== %s\e[0m  %s\n' "$rel" "$(<"$out.drift")"
    cat "$out"
  else
    printf '\n\e[1m== %s\e[0m  (none)  %s\n' "$rel" "$(<"$out.drift")"
  fi
done
