#!/usr/bin/env bash
# List open beads across every bead store under a root, deduping symlinked repos.
#
# usage: beads-all [--ready] [-s STATUSES] [--all] [ROOT]
#   --ready       use `bd ready` instead of `bd list`
#   -s STATUSES   comma-separated statuses for `bd list` (default: open,in_progress,blocked)
#   --all         print a header for stores with no matching beads too
#   ROOT          defaults to $BEADS_ALL_ROOT, then ~/Code/flurdy
set -euo pipefail

mode=list
statuses=open,in_progress,blocked
show_empty=0
root=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --ready) mode=ready ;;
    -s|--status) statuses=$2; shift ;;
    --all) show_empty=1 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) root=$1 ;;
  esac
  shift
done
root=$(realpath "${root:-${BEADS_ALL_ROOT:-$HOME/Code/flurdy}}")

# Discover stores following symlinks, prefer the shallowest display path, dedupe by real path.
mapfile -t stores < <(
  cd "$root" && find -L . -mindepth 2 -maxdepth 4 -type d -name .beads \
      -not -path '*/tbd/*' -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null \
    | sed 's|^\./||; s|/\.beads$||' \
    | awk -F/ '{ print NF "\t" $0 }' | sort -n -k1,1 -k2,2 | cut -f2 \
    | while read -r rel; do printf '%s\t%s\n' "$(realpath "$rel")" "$rel"; done \
    | awk -F'\t' '!seen[$1]++ { print $2 }'
)
[[ ${#stores[@]} -gt 0 ]] || { echo "no bead stores under $root" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

run_store() {
  local rel=$1 out=$2
  cd "$root/$rel" || return 0
  if [[ $mode == ready ]]; then
    bd ready 2>/dev/null
  else
    bd list -s "$statuses" --no-pager 2>/dev/null
  fi | grep -vE '^(-{10,}|Total: |Status: |Ready: |No (ready|issues)|$)' >"$out" || true
}
export -f run_store
export root mode statuses

i=0
for rel in "${stores[@]}"; do
  printf '%s\n' "$rel" >"$tmp/$i.name"
  i=$((i + 1))
done
printf '%s\n' "${stores[@]}" | nl -v0 -w1 -s$'\t' \
  | xargs -P8 -n1 -d'\n' bash -c 'IFS=$'"'"'\t'"'"' read -r n rel <<<"$0"; run_store "$rel" "'"$tmp"'/$n.out"'

for ((n = 0; n < i; n++)); do
  rel=$(<"$tmp/$n.name")
  out="$tmp/$n.out"
  if [[ -s $out ]] && grep -q '[^[:space:]]' "$out"; then
    printf '\n\e[1m== %s\e[0m\n' "$rel"
    cat "$out"
  elif [[ $show_empty == 1 ]]; then
    printf '\n\e[1m== %s\e[0m  (none)\n' "$rel"
  fi
done
