#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat >&2 <<'EOF'
Usage:
  secret-api-key lookup SERVICE PROJECT
  secret-api-key store SERVICE PROJECT
  secret-api-key list PROJECT
  secret-api-key list-projects
  secret-api-key search TERM
  secret-api-key remove SERVICE PROJECT [--confirm]

remove requires busctl and jq. Without --confirm it only previews.
It refuses missing, duplicate or locked matches and never reads secret values.
Confirmation permanently deletes one local item and verifies no matches remain.
There is no undo: recover by re-storing from an independent source or replacing
then storing the provider key. Local removal does not revoke the provider key.
Avoid concurrent keyring edits: identity is rechecked, but deletion is not atomic.
Prompts are not run automatically. On a failed request after deletion, inspect
metadata before retrying; a nonzero exit does not guarantee the item still exists.
remove exits: 0 preview/verified removal; 1 refusal/error; 2 invalid arguments.
EOF
	exit 2
}

validate_name() {
	local kind=$1
	local value=$2

	if [[ ! $value =~ ^[[:alnum:]_.-]+$ ]]; then
		printf 'Invalid %s: %s\n' "$kind" "$value" >&2
		exit 2
	fi
}

require_list_tools() {
	command -v busctl >/dev/null || {
		echo 'secret-api-key list requires busctl' >&2
		exit 1
	}
	command -v jq >/dev/null || {
		echo 'secret-api-key list requires jq' >&2
		exit 1
	}
}

require_unlocked_login_keyring() {
	local collection
	local locked

	collection="$(
		busctl --user --json=short call \
			org.freedesktop.secrets \
			/org/freedesktop/secrets \
			org.freedesktop.Secret.Service \
			ReadAlias s login \
			| jq -r '.data[0]'
	)"
	locked="$(
		busctl --user --json=short get-property \
			org.freedesktop.secrets \
			"$collection" \
			org.freedesktop.Secret.Collection \
			Locked \
			| jq -r '.data'
	)"
	if [[ $locked == true ]]; then
		echo 'Login keyring is locked; unlock it before listing API keys' >&2
		return 1
	fi
}

search_item_attributes() {
	local response
	local attributes=
	local item_attributes
	local path

	response="$(
		busctl --user --json=short call \
			org.freedesktop.secrets \
			/org/freedesktop/secrets \
			org.freedesktop.Secret.Service \
			SearchItems \
			'a{ss}' "$@"
	)"

	while IFS= read -r path; do
		if ! item_attributes="$(
			busctl --user --json=short get-property \
				org.freedesktop.secrets \
				"$path" \
				org.freedesktop.Secret.Item \
				Attributes
		)"; then
			echo 'Failed to list API keys: Secret Service disconnected' >&2
			return 1
		fi
		attributes+="$item_attributes"$'\n'
	done < <(jq -r '.data[][]' <<<"$response")

	printf '%s' "$attributes"
}

list_services() {
	local project=$1

	require_list_tools
	require_unlocked_login_keyring

	search_item_attributes 2 project "$project" credential api-key \
		| jq -r --arg project "$project" \
			'select(.data.project == $project and .data.credential == "api-key") | .data.service // empty' \
		| sort -u
}

list_projects() {
	require_list_tools
	require_unlocked_login_keyring

	search_item_attributes 1 credential api-key \
		| jq -r 'select(.data.credential == "api-key") | .data.project // empty' \
		| sort -u
}

search_services() {
	local term=$1

	require_list_tools
	require_unlocked_login_keyring

	search_item_attributes 1 credential api-key \
		| jq -r --arg term "$term" \
			'select(.data.credential == "api-key")
			 | select((.data.service // "") != "" and (.data.project // "") != "")
			 | select(.data.service | ascii_downcase | contains($term | ascii_downcase))
			 | [.data.service, .data.project]
			 | @tsv' \
		| sort -u
}

removal_busctl() {
	if ! busctl --user --json=short --timeout=5 \
		--allow-interactive-authorization=no -- "$@" 2>/dev/null; then
		echo 'Secret Service request failed; removal not confirmed' >&2
		return 1
	fi
}

removal_matches() {
	local response
	response="$(removal_busctl call org.freedesktop.secrets \
		/org/freedesktop/secrets org.freedesktop.Secret.Service SearchItems \
		'a{ss}' 3 service "$1" project "$2" credential api-key)" || return 1
	if ! jq -ces '
		select(length == 1) | .[0] | select(.type == "aoao") | .data
		| select(type == "array" and length == 2)
		| select(all(.[]; type == "array"))
		| select(all(.[][]; type == "string"
			and test("^(/[A-Za-z0-9_]+)+$")))
	' <<<"$response" 2>/dev/null; then
		echo 'Invalid Secret Service search response; refusing removal' >&2
		return 1
	fi
}

removal_target() {
	local service=$1 project=$2 matches count path response
	matches="$(removal_matches "$service" "$project")" || return 1
	count="$(jq '[.[][]] | length' <<<"$matches")" || return 1
	if [[ $count == 0 ]]; then
		echo 'No matching API key found' >&2
		return 1
	elif [[ $count != 1 ]]; then
		echo 'Multiple matching API keys; refusing removal' >&2
		return 1
	elif [[ $(jq '.[1] | length' <<<"$matches") != 0 ]]; then
		echo 'Matching API key is locked; unlock it separately before removal' >&2
		return 1
	fi
	path="$(jq -r '.[0][0]' <<<"$matches")" || return 1
	response="$(removal_busctl get-property org.freedesktop.secrets \
		"$path" org.freedesktop.Secret.Item Attributes)" || return 1
	if ! jq -es --arg service "$service" --arg project "$project" '
		length == 1 and (.[0] | .type == "a{ss}"
			and (.data | type == "object")
			and .data.service == $service and .data.project == $project
			and .data.credential == "api-key")
	' <<<"$response" >/dev/null 2>&1; then
		echo 'Target attributes changed or invalid; refusing removal' >&2
		return 1
	fi
	response="$(removal_busctl get-property org.freedesktop.secrets \
		"$path" org.freedesktop.Secret.Item Locked)" || return 1
	if ! jq -es 'length == 1 and (.[0] | .type == "b" and .data == false)' \
		<<<"$response" >/dev/null 2>&1; then
		echo 'Target locked or lock state unavailable; refusing removal' >&2
		return 1
	fi
	printf '%s\n' "$path"
}

remove_api_key() {
	local service=$1 project=$2 confirm=${3:-} tool path refreshed response prompt matches
	for tool in busctl jq; do
		command -v "$tool" >/dev/null || {
			printf 'secret-api-key remove requires %s\n' "$tool" >&2
			return 1
		}
	done
	path="$(removal_target "$service" "$project")" || return 1
	if [[ $confirm != --confirm ]]; then
		printf 'Would permanently remove API key: service=%s project=%s\n' "$service" "$project"
		printf 'No undo. To confirm: secret-api-key remove %s %s --confirm\n' "$service" "$project"
		return 0
	fi
	refreshed="$(removal_target "$service" "$project")" || return 1
	if [[ $refreshed != "$path" ]]; then
		echo 'Target changed during preflight; refusing removal' >&2
		return 1
	fi
	response="$(removal_busctl call org.freedesktop.secrets \
		"$path" org.freedesktop.Secret.Item Delete)" || return 1
	if ! prompt="$(jq -ers '
		select(length == 1) | .[0] | select(.type == "o") | .data
		| select(type == "array" and length == 1) | .[0]
		| select(type == "string" and test("^(/|(/[A-Za-z0-9_]+)+)$"))
	' <<<"$response" 2>/dev/null)"; then
		echo 'Invalid deletion response; removal not confirmed' >&2
		return 1
	fi
	if [[ $prompt != / ]]; then
		echo 'Keyring prompt required; removal not confirmed. Use the keyring UI instead.' >&2
		return 1
	fi
	matches="$(removal_matches "$service" "$project")" || return 1
	if [[ $(jq '[.[][]] | length' <<<"$matches") != 0 ]]; then
		echo 'Removal verification failed: matching items remain' >&2
		return 1
	fi
	printf 'Removed API key: service=%s project=%s\n' "$service" "$project"
}

[[ $# -ge 1 ]] || usage

action=$1
shift

case $action in
	lookup)
		[[ $# -eq 2 ]] || usage
		validate_name service "$1"
		validate_name project "$2"
		exec secret-tool lookup \
			service "$1" \
			project "$2" \
			credential api-key
		;;
	store)
		[[ $# -eq 2 ]] || usage
		validate_name service "$1"
		validate_name project "$2"
		exec secret-tool store \
			--label="$2 $1 API key" \
			service "$1" \
			project "$2" \
			credential api-key
		;;
	remove)
		[[ $# -eq 2 || ( $# -eq 3 && $3 == --confirm ) ]] || usage
		validate_name service "$1"
		validate_name project "$2"
		remove_api_key "$@"
		;;
	list)
		[[ $# -eq 1 ]] || usage
		validate_name project "$1"
		list_services "$1"
		;;
	list-projects)
		[[ $# -eq 0 ]] || usage
		list_projects
		;;
	search)
		[[ $# -eq 1 && -n $1 ]] || usage
		search_services "$1"
		;;
	*)
		usage
		;;
esac
